# Copy to .env.production; keep it outside version control.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=procureflow.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://procureflow.example.com
DJANGO_TRUST_PROXY=true
DJANGO_LOG_LEVEL=INFO
DB_NAME=procureflow
DB_USER=procureflow
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432
# Private local Compose network only. Use verify-full for a remote DB.
DB_SSLMODE=disable
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_URL=redis://redis:6379/2
